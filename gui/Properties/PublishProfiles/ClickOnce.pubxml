<?xml version="1.0" encoding="utf-8"?>
<!-- ClickOnce package of SDI Converter (x64, self-contained). Run scripts\publish-clickonce.ps1; the package ends up in publish\. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetCulture>en</TargetCulture>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>$(LOCALAPPDATA)\sdi_converter\gui-publish\app.publish\</PublishDir>
    <PublishUrl>$(LOCALAPPDATA)\sdi_converter\gui-publish\app.publish\</PublishUrl>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>True</SelfContained>
    <PublishSingleFile>True</PublishSingleFile>
    <PublishReadyToRun>False</PublishReadyToRun>
    <Install>True</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>False</UpdateEnabled>
    <UpdateRequired>False</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationVersion>1.0.0.1</ApplicationVersion>
    <ApplicationRevision>1</ApplicationRevision>
    <IsRevisionIncremented>False</IsRevisionIncremented>
    <PublisherName>Peter Aellig</PublisherName>
    <ProductName>SDI Converter</ProductName>
    <SuiteName>Peter Aellig</SuiteName>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <GenerateManifests>true</GenerateManifests>
    <SignManifests>False</SignManifests>
    <BootstrapperEnabled>True</BootstrapperEnabled>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <CreateWebPageOnPublish>False</CreateWebPageOnPublish>
    <OpenBrowserOnPublish>False</OpenBrowserOnPublish>
    <SkipPublishVerification>false</SkipPublishVerification>
    <UpdateMode>Foreground</UpdateMode>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine is built with the dynamic MSVC runtime. -->
    <BootstrapperPackage Include="Microsoft.Visual.C++.14.0.x64">
      <Install>true</Install>
      <ProductName>Visual C++ "14" Runtime Libraries (x64)</ProductName>
    </BootstrapperPackage>
  </ItemGroup>
</Project>
